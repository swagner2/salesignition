---
// Navigation.astro
---
<nav class="nav">
  <div class="nav__inner">
    <a class="nav__logo" href="/">
      <img src="/images/Steve-SR-Crop.png"
        alt="Steven" class="nav__logo-avatar"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
      <span class="nav__logo-fallback" style="display: none;">SI</span>
      <span class="nav__logo-name">Steven<span class="nav__logo-sub">Email Deliverability Expert</span></span>
    </a>
    <ul class="nav__links" id="nav-links">
      <li class="nav__dropdown">
        <a href="#">My Tools</a>
        <div class="nav__dropdown-menu">
          <a href="/audit">Free Email Audit Tool</a>
          <a href="https://inboxsmarts.com" target="_blank" rel="noopener noreferrer">InboxSmarts — Warm-Up</a>
          <a href="/#stealflows">StealFlows — Klaviyo Templates</a>
        </div>
      </li>
      <li><a href="/#portfolio">Portfolio</a></li>
      <li><a href="/#about">About</a></li>
      <li class="nav__cta"><a href="/work-with-me">Work With Me</a></li>
    </ul>
    <button class="nav__hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<script>
  // Hamburger toggle + dropdown behavior
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');
  if (hamburger && navLinks) {
    hamburger.addEventListener('click', () => {
      navLinks.classList.toggle('open');
    });
  }

  if (navLinks) {
    navLinks.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navLinks.classList.remove('open');
      });
    });
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (navLinks && !target.closest('.nav')) {
      navLinks.classList.remove('open');
    }
  });
</script>
