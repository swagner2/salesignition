      <button class="cat-btn" data-cat="campaigns">Campaigns</button>
      <button class="cat-btn" data-cat="casestudy">Case Studies</button>
    </div>
  </div>
</div>

<!-- ══ ARTICLES GRID ══════════════════════════════════ -->
