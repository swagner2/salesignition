---
export const prerender = true;
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Why Your Emails Are Going to Spam (And the 7-Step Fix) | Sales Ignition Blog</title>
  <meta name="description" content="A practical diagnosis guide for email deliverability problems — with a 7-step fix sequence used on real DTC accounts.">
  <link rel="canonical" href="https://blog.salesignition.com/why-emails-go-to-spam.html">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;0,800;1,400;1,700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:           #ffffff;
      --bg-alt:       #f7f6f3;
      --bg-card:      #f2f1ee;
      --border:       #e2e1de;
      --border-light: #d0cfc9;
      --text:         #1a1a1a;
      --text-muted:   #666666;
      --text-dim:     #999999;
      --accent:       #e84c1e;
      --accent-dark:  #c93d14;
      --accent-light: #fef2ee;
      --font:         'Open Sans', sans-serif;
      --max:          1080px;
      --radius:       5px;
      --sidebar-w:    320px;
    }

    html { scroll-behavior: smooth; }
    body { font-family: var(--font); font-size: 17px; line-height: 1.75; color: var(--text); background: var(--bg); -webkit-font-smoothing: antialiased; }

    .container { max-width: var(--max); margin: 0 auto; padding: 0 36px; }

    .eyebrow { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 14px; }

    h1 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.025em; color: var(--text); }
    h2 { font-size: 1.5rem; font-weight: 700; line-height: 1.25; letter-spacing: -0.015em; color: var(--text); margin: 36px 0 14px; }
    h3 { font-size: 1.15rem; font-weight: 700; line-height: 1.35; color: var(--text); margin: 28px 0 10px; }
    p { margin-bottom: 20px; color: var(--text-muted); line-height: 1.8; }
    p:last-child { margin-bottom: 0; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    strong { font-weight: 700; color: var(--text); }
    em { font-style: italic; }

    /* ── BUTTONS ─────────────────────────────────────────── */
    .btn { display: inline-block; background: var(--accent); color: #fff; font-family: var(--font); font-size: 15px; font-weight: 700; padding: 13px 28px; border-radius: var(--radius); text-decoration: none; transition: background 0.15s, transform 0.12s; white-space: nowrap; }
    .btn:hover { background: var(--accent-dark); text-decoration: none; transform: translateY(-1px); }
    .btn--ghost { background: transparent; color: var(--text); border: 1.5px solid var(--border-light); }
    .btn--ghost:hover { background: var(--bg-alt); color: var(--text); text-decoration: none; transform: none; }
    .btn--sm { font-size: 13px; padding: 9px 18px; }
    .btn--block { display: block; text-align: center; width: 100%; }

    /* ── NAV ─────────────────────────────────────────────── */
    .nav { position: sticky; top: 0; z-index: 200; background: var(--bg); border-bottom: 1px solid var(--border); }
    .nav__inner { max-width: var(--max); margin: 0 auto; padding: 0 36px; display: flex; align-items: center; justify-content: space-between; height: 66px; gap: 20px; }
    .nav__logo { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }
    .nav__logo-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); flex-shrink: 0; }
    .nav__logo-fallback { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); display: none; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; color: #fff; flex-shrink: 0; }
    .nav__logo-name { font-size: 14px; font-weight: 700; color: var(--text); line-height: 1.25; }
    .nav__logo-sub { display: block; font-size: 11px; font-weight: 400; color: var(--text-muted); }
    .nav__links { display: flex; align-items: center; list-style: none; gap: 2px; flex: 1; justify-content: flex-end; }
    .nav__links > li > a { display: block; font-size: 14px; font-weight: 600; color: var(--text-muted); padding: 6px 13px; border-radius: var(--radius); transition: color 0.12s, background 0.12s; text-decoration: none; white-space: nowrap; }
    .nav__links > li > a:hover { color: var(--text); background: var(--bg-alt); }
    .nav__links > li.nav__cta > a { background: var(--accent); color: #fff; font-weight: 700; }
    .nav__links > li.nav__cta > a:hover { background: var(--accent-dark); }
    .nav__hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 6px; }
    .nav__hamburger span { display: block; width: 22px; height: 2px; background: var(--text-muted); border-radius: 2px; }

    /* ── BREADCRUMB ───────────────────────────────────────── */
    .breadcrumb { padding: 16px 0; border-bottom: 1px solid var(--border); font-size: 13px; color: var(--text-dim); }
    .breadcrumb a { color: var(--text-dim); text-decoration: none; }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb span { margin: 0 8px; }

    /* ── ARTICLE HEADER ──────────────────────────────────── */
    .article-header { padding: 48px 0 40px; border-bottom: 1px solid var(--border); }
    .article-header__cat { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); background: var(--accent-light); border-radius: 100px; padding: 3px 11px; margin-bottom: 16px; }
    .article-header h1 { max-width: 760px; margin-bottom: 20px; }
    .article-header__intro { font-size: 1.1rem; color: var(--text-muted); max-width: 680px; line-height: 1.75; margin-bottom: 28px; }
    .article-header__meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding-top: 20px; border-top: 1px solid var(--border); }
    .article-header__avatar { width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--border); overflow: hidden; flex-shrink: 0; }
    .article-header__avatar img { width: 100%; height: 100%; object-fit: cover; }
    .article-header__byline { font-size: 14px; line-height: 1.4; }
    .article-header__byline strong { display: block; }
    .article-header__divider { width: 1px; height: 28px; background: var(--border); }
    .article-header__stats { font-size: 13px; color: var(--text-dim); display: flex; gap: 16px; flex-wrap: wrap; }
    .article-header__tag { display: inline-block; font-size: 12px; font-weight: 600; color: var(--text-muted); background: var(--bg-alt); border: 1px solid var(--border); border-radius: 100px; padding: 2px 10px; }

    /* ── HERO IMAGE ───────────────────────────────────────── */
    .article-hero-img { width: 100%; aspect-ratio: 21/9; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin: 36px 0; display: flex; align-items: center; justify-content: center; color: var(--text-dim); font-size: 13px; }
    .article-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* ── MAIN LAYOUT ─────────────────────────────────────── */
    .article-layout { padding: 0 0 80px; }
    .article-layout__inner {
      display: grid;
      grid-template-columns: 1fr var(--sidebar-w);
      gap: 56px;
      align-items: start;
      padding-top: 48px;
    }

    /* ── ARTICLE CONTENT ─────────────────────────────────── */
    .article-content { min-width: 0; }

    /* TOC */
    .toc { background: var(--bg-alt); border: 1px solid var(--border); border-radius: 8px; padding: 22px 24px; margin-bottom: 36px; }
    .toc__title { font-size: 12px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 12px; display: block; }
    .toc ol { list-style: none; counter-reset: toc; }
    .toc ol li { counter-increment: toc; padding: 5px 0; border-bottom: 1px solid var(--border); display: flex; align-items: baseline; gap: 10px; }
    .toc ol li:last-child { border-bottom: none; }
    .toc ol li::before { content: counter(toc) "."; font-size: 11px; font-weight: 800; color: var(--accent); flex-shrink: 0; min-width: 18px; }
    .toc ol li a { font-size: 14px; color: var(--text-muted); text-decoration: none; }
    .toc ol li a:hover { color: var(--accent); }

    /* Callout boxes */
    .callout { border-left: 3px solid var(--accent); background: var(--accent-light); border-radius: 0 6px 6px 0; padding: 16px 20px; margin: 28px 0; }
    .callout p { margin-bottom: 0; font-size: 15px; color: var(--text); }
    .callout--warn { border-left-color: #d97706; background: #fffbeb; }
    .callout--tip { border-left-color: #16a34a; background: #f0fdf4; }

    /* Step boxes */
    .step { background: var(--bg-alt); border: 1px solid var(--border); border-radius: 8px; padding: 24px 26px; margin: 20px 0; }
    .step__num { font-size: 10px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 6px; }
    .step h3 { margin: 0 0 10px; font-size: 1.05rem; }
    .step p { font-size: 15px; margin-bottom: 0; }
    .step p + p { margin-top: 10px; }

    /* Checklist */
    .check-list { list-style: none; margin: 18px 0 24px; }
    .check-list li { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 16px; color: var(--text-muted); line-height: 1.6; }
    .check-list li:first-child { border-top: 1px solid var(--border); }
    .check-list li::before { content: '→'; color: var(--accent); font-weight: 700; flex-shrink: 0; }

    /* Stat pullout */
    .stat-pull { background: var(--text); color: #fff; border-radius: 8px; padding: 28px 30px; margin: 32px 0; }
    .stat-pull__num { font-size: 3rem; font-weight: 800; color: var(--accent); line-height: 1; display: block; margin-bottom: 6px; }
    .stat-pull p { color: rgba(255,255,255,0.7); font-size: 15px; margin-bottom: 0; }

    /* Inline image */
    .article-img { width: 100%; border-radius: 7px; border: 1px solid var(--border); display: block; margin: 28px 0; }
    .article-img-caption { text-align: center; font-size: 13px; color: var(--text-dim); margin-top: -18px; margin-bottom: 28px; }
    .article-img-placeholder { width: 100%; aspect-ratio: 16/9; background: var(--bg-alt); border: 1px dashed var(--border-light); border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--text-dim); margin: 28px 0; }

    /* Article share / end section */
    .article-end { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--border); }
    .article-end__tags { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 24px; }
    .article-end__tag { display: inline-block; font-size: 12px; font-weight: 600; color: var(--text-muted); background: var(--bg-alt); border: 1px solid var(--border); border-radius: 100px; padding: 4px 12px; text-decoration: none; }
    .article-end__tag:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
    .article-end__share { font-size: 13px; color: var(--text-dim); }

    /* Author card */
    .author-card { background: var(--bg-alt); border: 1px solid var(--border); border-radius: 8px; padding: 28px; margin-top: 36px; display: flex; gap: 20px; align-items: flex-start; }
    .author-card__avatar { width: 64px; height: 64px; border-radius: 50%; border: 1px solid var(--border); overflow: hidden; flex-shrink: 0; background: var(--bg-card); display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--accent); }
    .author-card__avatar img { width: 100%; height: 100%; object-fit: cover; }
    .author-card__name { font-weight: 800; color: var(--text); font-size: 1rem; margin-bottom: 4px; display: block; }
    .author-card__title { font-size: 13px; color: var(--text-dim); margin-bottom: 12px; display: block; }
    .author-card p { font-size: 14px; margin-bottom: 0; }

    /* Related articles */
    .related { margin-top: 56px; padding-top: 36px; border-top: 1px solid var(--border); }
    .related h3 { font-size: 1.1rem; margin-bottom: 22px; }
    .related__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .related-card { border: 1px solid var(--border); border-radius: 7px; padding: 18px; background: var(--bg); transition: transform 0.15s; }
    .related-card:hover { transform: translateY(-2px); text-decoration: none; }
    .related-card__cat { font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 6px; }
    .related-card__title { font-size: 14px; font-weight: 700; color: var(--text); line-height: 1.4; display: block; }
    .related-card__meta { font-size: 12px; color: var(--text-dim); margin-top: 8px; display: block; }

    /* ── SIDEBAR ─────────────────────────────────────────── */
    .sidebar { position: sticky; top: 82px; display: flex; flex-direction: column; gap: 22px; }

    .sidebar-card { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }

    /* ERA Promo Card */
    .sidebar-promo { background: var(--text); color: #fff; padding: 26px; }
    .sidebar-promo__eyebrow { font-size: 10px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.4); display: block; margin-bottom: 12px; }
    .sidebar-promo h4 { font-size: 1rem; font-weight: 800; color: #fff; line-height: 1.35; margin-bottom: 10px; }
    .sidebar-promo p { font-size: 13.5px; color: rgba(255,255,255,0.62); line-height: 1.7; margin-bottom: 18px; }
    .sidebar-promo .btn { width: 100%; text-align: center; font-size: 14px; padding: 12px 20px; display: block; }

    /* Audit Tool Card */
    .sidebar-audit { background: var(--bg-alt); padding: 22px; }
    .sidebar-audit__icon { font-size: 28px; display: block; margin-bottom: 10px; }
    .sidebar-audit h4 { font-size: 0.95rem; font-weight: 700; color: var(--text); margin-bottom: 8px; }
    .sidebar-audit p { font-size: 13px; color: var(--text-muted); line-height: 1.65; margin-bottom: 16px; }
    .sidebar-audit .btn { width: 100%; text-align: center; font-size: 13px; padding: 10px 16px; display: block; }

    /* Services Card */
    .sidebar-services { background: var(--bg); padding: 22px; }
    .sidebar-services h4 { font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 14px; }
    .sidebar-services__list { list-style: none; }
    .sidebar-services__list li { border-bottom: 1px solid var(--border); }
    .sidebar-services__list li:last-child { border-bottom: none; }
    .sidebar-services__list a { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; font-size: 14px; font-weight: 600; color: var(--text); text-decoration: none; transition: color 0.12s; }
    .sidebar-services__list a:hover { color: var(--accent); }
    .sidebar-services__list a::after { content: '→'; color: var(--accent); font-size: 12px; opacity: 0; transition: opacity 0.12s; }
    .sidebar-services__list a:hover::after { opacity: 1; }

    /* Newsletter sidebar */
    .sidebar-newsletter { background: var(--bg); padding: 22px; }
    .sidebar-newsletter h4 { font-size: 0.95rem; font-weight: 700; color: var(--text); margin-bottom: 8px; }
    .sidebar-newsletter p { font-size: 13px; color: var(--text-muted); margin-bottom: 14px; }
    .sidebar-newsletter input { width: 100%; padding: 10px 13px; font-family: var(--font); font-size: 14px; border: 1.5px solid var(--border-light); border-radius: var(--radius); color: var(--text); background: var(--bg-alt); outline: none; transition: border-color 0.15s; margin-bottom: 9px; }
    .sidebar-newsletter input:focus { border-color: var(--accent); }
    .sidebar-newsletter input::placeholder { color: var(--text-dim); }
    .sidebar-newsletter .btn { width: 100%; text-align: center; font-size: 13px; padding: 10px 16px; display: block; }

    /* Popular posts */
    .sidebar-popular { background: var(--bg); padding: 22px; }
    .sidebar-popular h4 { font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 14px; }
    .popular-list { list-style: none; }
    .popular-list li { display: flex; gap: 10px; align-items: flex-start; padding: 10px 0; border-bottom: 1px solid var(--border); }
    .popular-list li:last-child { border-bottom: none; }
    .popular-list__num { font-size: 13px; font-weight: 800; color: var(--accent); min-width: 18px; }
    .popular-list a { font-size: 13px; font-weight: 600; color: var(--text-muted); line-height: 1.4; text-decoration: none; }
    .popular-list a:hover { color: var(--accent); }

    /* ── FOOTER ──────────────────────────────────────────── */
    footer { border-top: 1px solid var(--border); padding: 26px 36px; display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: var(--text-dim); flex-wrap: wrap; gap: 12px; }
    footer a { color: var(--text-dim); text-decoration: none; }
    footer a:hover { color: var(--text-muted); }
    .footer__links { display: flex; gap: 18px; }

    /* ── RESPONSIVE ──────────────────────────────────────── */
    @media (max-width: 900px) {
      .article-layout__inner { grid-template-columns: 1fr; gap: 40px; }
      .sidebar { position: static; }
      .related__grid { grid-template-columns: 1fr; }
      .nav__links { display: none; flex-direction: column; position: absolute; top: 66px; left: 0; right: 0; background: var(--bg); border-bottom: 1px solid var(--border); padding: 14px 24px 18px; z-index: 500; }
      .nav__links.open { display: flex; }
      .nav__hamburger { display: flex; }
      .container { padding: 0 24px; }
    }
    @media (max-width: 580px) {
      h1 { font-size: 1.8rem; }
      footer { flex-direction: column; text-align: center; }
    }
  </style>
</head>
<body>

<!-- ══ NAV ══════════════════════════════════════════════ -->
<nav class="nav">
  <div class="nav__inner">
    <a class="nav__logo" href="/">
      <img src="/blog/images/steven-headshot.png"
        alt="Steven" class="nav__logo-avatar"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
      <span class="nav__logo-fallback">SI</span>
      <span class="nav__logo-name">Sales Ignition<span class="nav__logo-sub">Email Marketing Blog</span></span>
    </a>
    <ul class="nav__links" id="nav-links">
      <li><a href="/">← All Articles</a></li>
      <li><a href="https://salesignition.com" target="_blank">Main Site</a></li>
