  <Fragment set:html={post.body} />
</article>
      <!-- ░░░░░░ END MAIN CONTENT ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░ -->


      <!-- ░░░░░░ SIDEBAR ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░ -->
      <aside class="sidebar">

        <!-- 1. ERA Program Promo -->
        <div class="sidebar-card">
          <div class="sidebar-promo">
            <span class="sidebar-promo__eyebrow">6-Month Program</span>
