    </ul>
    <button class="nav__hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- ══ BREADCRUMB ════════════════════════════════════════ -->
<div class="breadcrumb">
