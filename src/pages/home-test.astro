---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const pages = await getCollection('pages');
const homeTest = pages.find(p => p.slug === 'home-test');

if (!homeTest) {
  throw new Error('Home test page not found in Keystatic');
}

const { Content } = await homeTest.render();
---

<Layout title={homeTest.data.title} description={homeTest.data.description}>
  <main style="padding: 40px 20px; max-width: 900px; margin: 0 auto;">
    <Content />
  </main>
</Layout>
