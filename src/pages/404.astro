---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Page Not Found | Sales Ignition" theme="light">
  <section class="error-section">
    <div class="container">
      <div class="error-content">
        <span class="eyebrow">Error 404</span>
        <h1>Page Not Found</h1>
        <p class="muted">Sorry, the page you are looking for doesn't exist or has been moved.</p>
        <div class="actions">
          <a href="/" class="btn">Return Home</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-section {
    padding: 120px 0;
    text-align: center;
    min-height: calc(100vh - 250px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .error-content {
    max-width: 480px;
    margin: 0 auto;
  }
  h1 {
    margin-top: 10px;
    margin-bottom: 20px;
  }
  p {
    font-size: 18px;
    margin-bottom: 30px;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 15px;
  }
</style>
